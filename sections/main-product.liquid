<section class="product-page page-width" data-product-section>
  <a class="back-link" href="/collections/all-products">← BACK TO SHOP</a>
  <div class="product-layout">
    <div class="product-media">
      {% for media in product.media %}
        <div class="product-media__item">
          {% assign media_alt = media.alt | default: product.title %}
          {% if media.media_type == 'image' %}
            {{ media | image_url: width: 1400 | image_tag: loading: 'lazy', alt: media_alt }}
          {% else %}
            {{ media | media_tag: image_size: '1400x', autoplay: false, loop: false, controls: true }}
          {% endif %}
        </div>
      {% else %}
        <div class="product-media__item placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
      {% endfor %}
    </div>
    <div class="product-info">
      <p>{{ product.type | default: 'SPAIZD DROP' }}</p>
      <h1>{{ product.title }}</h1>
      <div class="price" data-product-price>{{ product.selected_or_first_available_variant.price | money }}</div>
      {% if product.description != blank %}<div class="rte">{{ product.description }}</div>{% endif %}
      {% form 'product', product, class: 'product-form js-product-form' %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-variant-id>
        {% unless product.has_only_default_variant %}
          {% for option in product.options_with_values %}
            <fieldset class="variant-picker">
              <legend>{{ option.name }}</legend>
              {% for value in option.values %}
                <label><input type="radio" name="option{{ option.position }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}> <span>{{ value }}</span></label>
              {% endfor %}
            </fieldset>
          {% endfor %}
        {% endunless %}
        <label class="quantity-label" for="Quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
        <input id="Quantity-{{ section.id }}" class="quantity-input" type="number" name="quantity" value="1" min="1">
        <button class="button button--full" type="submit" data-add-text="{{ 'products.product.add_to_cart' | t }}" data-sold-text="{{ 'general.sold_out' | t }}" {% unless product.available %}disabled{% endunless %}>
          {% if product.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'general.sold_out' | t }}{% endif %}
        </button>
      {% endform %}
      <script type="application/json" data-product-json>{{ product.variants | json }}</script>
      <div class="product-notes">
        <details><summary>SIZE GUIDE</summary><p>Use your usual streetwear size for a relaxed fit. Add store-specific measurements in product descriptions or assign the Size guide page template.</p></details>
        <details><summary>SHIPPING & RETURNS</summary><p>Checkout, taxes, shipping, and returns are handled by Shopify.</p></details>
      </div>
    </div>
  </div>
</section>
{% schema %}
{ "name": "Main product" }
{% endschema %}
