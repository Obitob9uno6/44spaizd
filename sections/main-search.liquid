<section class="page page-width">
  <h1>SEARCH</h1>
  <form action="{{ routes.search_url }}" method="get" class="search-form"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="SEARCH PRODUCTS"><button class="button" type="submit">SEARCH</button></form>
  {% if search.performed %}<div class="product-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% endif %}{% else %}<p>No results found.</p>{% endfor %}</div>{% endif %}
</section>
{% schema %}
{ "name": "Search" }
{% endschema %}
