<section class="section newsletter page-width">
  <h2>{{ section.settings.heading }}</h2>
  <p>{{ section.settings.text }}</p>
  {% form 'customer', class: 'newsletter-form newsletter-form--large' %}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <input type="email" name="contact[email]" placeholder="EMAIL ADDRESS" required>
    <button type="submit">JOIN</button>
    {% if form.posted_successfully? %}<p class="form-success">You’re on the list.</p>{% endif %}
    {{ form.errors | default_errors }}
  {% endform %}
</section>
{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "CATCH THE NEXT DROP" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Subscribe for launch alerts, restock signals, and VIP access." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
