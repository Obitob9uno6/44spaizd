<section class="vip-promo">
  <div class="vip-promo__bg"><img src="{{ 'vip-bg-default.jpg' | asset_url }}" alt=""></div>
  <div class="vip-promo__inner page-width">
    <p>{{ section.settings.kicker }}</p>
    <h2>{{ section.settings.heading }}</h2>
    <div>{{ section.settings.text }}</div>
    <a class="button button--secondary" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
  </div>
</section>
{% schema %}
{
  "name": "VIP promo",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "PRIVATE HARVEST" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "JOIN THE VIP CLUB" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Early access to drops, member-only pieces, and behind-the-scenes smoke signals." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "GET ON THE LIST" },
    { "type": "url", "id": "button_link", "label": "Button link", "default": "/pages/vip" }
  ],
  "presets": [{ "name": "VIP promo" }]
}
{% endschema %}
