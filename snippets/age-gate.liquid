<div class="age-gate" data-age-gate hidden>
  <div class="age-gate__card">
    <img src="{{ 'cannabis-leaf-transparent.png' | asset_url }}" alt="" width="80" height="80" loading="lazy">
    <h2>{{ settings.age_gate_heading }}</h2>
    <p>{{ settings.age_gate_text }}</p>
    <div class="age-gate__actions">
      <button type="button" data-age-accept>YES, ENTER</button>
      <a href="https://www.google.com">NO, LEAVE</a>
    </div>
  </div>
</div>
