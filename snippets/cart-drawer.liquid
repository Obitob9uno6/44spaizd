<div class="cart-drawer" data-cart-drawer hidden>
  <button class="cart-drawer__overlay" type="button" data-cart-close aria-label="Close cart"></button>
  <aside class="cart-drawer__panel" aria-label="Cart drawer" tabindex="-1">
    <div class="cart-drawer__bg"></div>
    <div class="cart-drawer__head">
      <h2>✂ TRIM ROOM <span data-cart-drawer-count>[{{ cart.item_count }}]</span></h2>
      <button type="button" data-cart-close aria-label="Close">×</button>
    </div>
    <div class="cart-drawer__items" data-cart-items>
      {% if cart.item_count == 0 %}
        <div class="cart-empty" data-cart-empty>
          <h3>YOUR TRIM ROOM IS EMPTY</h3>
          <p>Add pieces to your trim room and we’ll get you sorted.</p>
          <a class="button" href="/collections/all-products">EXPLORE COLLECTION</a>
        </div>
      {% else %}
        {% for item in cart.items %}
          <div class="cart-item" data-line="{{ forloop.index }}">
            {% if item.image %}<img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.image.alt | escape }}" loading="lazy">{% endif %}
            <div class="cart-item__body">
              <h3>{{ item.product.title }}</h3>
              <p>{{ item.variant.title }}</p>
              <div class="cart-item__controls">
                <button type="button" data-cart-change="{{ forloop.index }}" data-quantity="{{ item.quantity | minus: 1 }}">−</button>
                <span>{{ item.quantity }}</span>
                <button type="button" data-cart-change="{{ forloop.index }}" data-quantity="{{ item.quantity | plus: 1 }}">+</button>
                <button type="button" class="cart-item__remove" data-cart-change="{{ forloop.index }}" data-quantity="0">Remove</button>
              </div>
            </div>
            <strong>{{ item.final_line_price | money }}</strong>
          </div>
        {% endfor %}
      {% endif %}
    </div>
    <div class="cart-drawer__foot" data-cart-footer {% if cart.item_count == 0 %}hidden{% endif %}>
      <div><span>SUBTOTAL</span><strong data-cart-total>{{ cart.total_price | money }}</strong></div>
      <a class="button button--full" href="{{ routes.checkout_url }}">CHECKOUT THE HARVEST</a>
      <a class="cart-link-muted" href="{{ routes.cart_url }}">VIEW CART</a>
    </div>
  </aside>
</div>
